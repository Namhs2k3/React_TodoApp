{
    "indent_size": 2,
    "indent_with_tabs": false,
    "preserve_newlines": true,
    "max_preserve_newlines": 2,
    "wrap_line_length": 120,
    "indent_body_inner_html": true,
    "wrap_attributes": "preserve-aligned",
    "templating": [
        "angular"
    ],
    "beautify.ignore": [
    "**/node_modules/**/*",
    "**/build/**/*",
    "**/coverage/**/*",
    "**/dist/**/*"
    ]
}